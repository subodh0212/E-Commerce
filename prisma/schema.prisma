// Prisma Schema for Hybrid E-Commerce & Booking Platform (Amazon/Flipkart Style)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  bookings      Booking[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  price            Float
  originalPrice    Float?
  discountPercent  Int         @default(0)
  stock            Int         @default(0)
  category         String
  brand            String?
  rating           Float       @default(5.0)
  reviewsCount     Int         @default(120)
  images           String      @default("[]") // JSON string of image URLs
  isBookable       Boolean     @default(false)
  isExpress        Boolean     @default(true)
  deliveryEstimate String      @default("Tomorrow, by 11 AM")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orderItems       OrderItem[]
  bookings         Booking[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      String      @default("PENDING")
  stripeId    String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id])
  date       String        // Format: YYYY-MM-DD
  timeSlot   String        // Format: e.g. "09:00 AM" or "14:00"
  status     String        @default("PENDING")
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
